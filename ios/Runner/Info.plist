<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Caller-Noted</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>caller_noted</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Privacy Permissions for Calendars -->
	<key>NSCalendarsUsageDescription</key>
	<string>Caller-Noted richiede l'accesso al calendario per salvare e consultare gli appuntamenti concordati al telefono.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Caller-Noted salva i tuoi nuovi appuntamenti nel tuo calendario preferito.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Caller-Noted gestisce i tuoi calendari per inserire gli appuntamenti dopo le chiamate.</string>

	<!-- Privacy Permissions for Contacts -->
	<key>NSContactsUsageDescription</key>
	<string>Caller-Noted legge e salva i contatti per associare nome e numero di telefono agli appuntamenti.</string>

	<!-- Privacy Permissions for Microphone and Speech -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Caller-Noted utilizza il microfono per consentirti di dettare a voce i dettagli dell'appuntamento.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Caller-Noted trascrive la tua voce per estrarre data, ora e luogo dell'intervento.</string>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
